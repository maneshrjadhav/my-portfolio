# ── Optional environment variables ─────────────────────────────
# All values are optional — the site works without a .env file.

# Contact form endpoint (Formspree, Web3Forms, Getform, etc.)
# If empty, the contact form falls back to opening the visitor's
# email client with a pre-filled message.
VITE_FORM_ENDPOINT=

# Public URL of your resume PDF.
# If empty, the Resume button downloads /resume.pdf from the public folder.
VITE_RESUME_URL=

# Your GitHub username used by the GitHub activity section.
VITE_GITHUB_USERNAME=maneshjadhav
